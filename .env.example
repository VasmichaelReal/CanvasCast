# --- Інфраструктура (значення відповідають infra/docker-compose.yml) ---
DATABASE_URL=postgresql://canvascast:canvascast@localhost:5433/canvascast
REDIS_URL=redis://localhost:6380
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=canvascast
S3_ACCESS_KEY=canvascast
S3_SECRET_KEY=canvascast-secret

# Публічна адреса застосунку для посилань і QR. Порожньо = брати з запиту.
APP_URL=

# Лише для хостингу: адреса воркера, якщо хостинг присипляє сервіси без запитів (Render).
# Веб-застосунок звертається до неї, щоб розбудити воркер. Локально лишіть порожнім.
WORKER_URL=

# --- Опис картини (vision-LLM) ---
# auto = gemini, якщо задано GEMINI_API_KEY, інакше mock (демо-текст без AI)
LLM_PROVIDER=auto
# Безкоштовний ключ: https://aistudio.google.com → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Резервна модель, якщо основна перевантажена або вичерпала квоту (порожньо = без резерву)
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# --- Озвучення (TTS) ---
# edge   = безкоштовні нейроголоси Microsoft Edge, ключ не потрібен (неофіційний доступ)
# gemini = Gemini TTS тим самим GEMINI_API_KEY (офіційний free tier, малі денні ліміти)
# mock   = тиша (для тестів)
TTS_PROVIDER=edge
TTS_VOICE_UK=uk-UA-PolinaNeural
TTS_VOICE_EN=en-GB-SoniaNeural
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# --- Ліміти ---
# Задач генерації на хвилину (безкоштовний Gemini дозволяє 5 запитів/хв на модель)
GENERATIONS_PER_MINUTE=4
MAX_UPLOAD_MB=15
MAX_PAINTINGS_PER_GALLERY=60
MAX_GENERATIONS_PER_GALLERY_PER_DAY=150
